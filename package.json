{
  "name": "cosechas-estoque",
  "productName": "Siembras Etiquetas",
  "version": "1.0.2",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "electron:start": "electron .",
    "electron:rebuild:electron": "electron-rebuild -f -w better-sqlite3",
    "electron:rebuild:node": "npm rebuild better-sqlite3",
    "electron:dist": "npm run build && npm run electron:rebuild:electron && electron-builder --win --config.npmRebuild=false && npm run electron:rebuild:node",
    "electron:publish": "npm run build && npm run electron:rebuild:electron && electron-builder --win --config.npmRebuild=false --publish always && npm run electron:rebuild:node"
  },
  "build": {
    "appId": "com.cosechas.etiquetas",
    "productName": "Siembras Etiquetas",
    "asar": false,
    "publish": {
      "provider": "github",
      "owner": "FILIPIWQS",
      "repo": "cosechas-app"
    },
    "files": [
      ".next/**/*",
      "public/**/*",
      "electron/**/*",
      "lib/**/*",
      "package.json",
      "node_modules/**/*",
      "!node_modules/electron/**/*",
      "!node_modules/electron-builder/**/*",
      "!node_modules/sharp/**/*",
      "!node_modules/png-to-ico/**/*"
    ],
    "extraResources": [],
    "win": {
      "target": "nsis",
      "icon": "electron/build/icon.ico",
      "signExecutable": false
    },
    "forceCodeSigning": false,
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "include": "electron/build/installer.nsh"
    }
  },
  "dependencies": {
    "@upstash/redis": "^1.34.0",
    "better-sqlite3": "^12.11.1",
    "electron-updater": "^6.8.9",
    "next": "^14.2.0",
    "pdf-lib": "^1.17.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "electron": "^40.10.6",
    "electron-builder": "^26.15.3",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.3"
  }
}
